[gd_scene format=3]

[ext_resource type="Script" path="res://script/component/input_hint.gd" id="1_hint"]
[ext_resource type="PackedScene" path="res://scene/component/input_prompt.tscn" id="2_prompt"]
[ext_resource type="FontFile" path="res://font/text_font.ttf" id="3_font"]

[node name="InputHint" type="HBoxContainer"]
mouse_filter = 2
theme_override_constants/separation = 4
script = ExtResource("1_hint")

[node name="PromptSlot" type="Control" parent="."]
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2

[node name="InputPrompt" parent="PromptSlot" instance=ExtResource("2_prompt")]

[node name="Label" type="Label" parent="."]
layout_mode = 2
size_flags_vertical = 4
theme_override_fonts/font = ExtResource("3_font")
theme_override_font_sizes/font_size = 8
text = "text"
